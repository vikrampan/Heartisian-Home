{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/admin.ts": {
      "maxDuration": 60
    },
    "api/cron.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 2 * * *"
    }
  ],
  "regions": [
    "hnd1"
  ]
}
