# Copy to .env.local for local development, and add the same names in Vercel → Project → Settings →
# Environment Variables for the live site. Never commit real values: this repository is public.
# Without the Supabase keys, `npm run dev` uses a local sample database instead (see dev/api-dev.ts).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# the "anon" / publishable key: safe in the browser; used only for the admin's sign-in
VITE_SUPABASE_ANON_KEY=
# the "service_role" / secret key: server only, never expose it
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Heartisan Home <workshops@heartisanhome.com>

# Links in emails point here
SITE_URL=https://heartisanhome.com

# Any long random string; Vercel sends it to the daily job (reminders, ending lapsed holds)
CRON_SECRET=
